<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.achivement.mapper.AchivementMapper">
    <select id="getAchivement" resultType="AchivementModel" parameterType="AchivementModel" statementType="CALLABLE">
        {
            call SP_ACHIVEMENT_SELECT(
                @ACHIVE_NM = #{achiveNm, mode=IN, jdbcType=NVARCHAR},
                @USE_YN = #{useYn, mode=IN, jdbcType=CHAR}
            )
        }
    </select>

</mapper>